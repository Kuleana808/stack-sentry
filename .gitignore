# Paths are unrooted so they match at any workspace depth (apps/*, packages/*),
# not just the repo root.

# dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# build output
.next/
out/
build/
dist/

# testing
coverage/

# typescript
*.tsbuildinfo
next-env.d.ts

# env — never commit a real key
.env
.env.local
.env*.local

# vercel
.vercel

# supabase
supabase/.temp/
supabase/.branches/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
