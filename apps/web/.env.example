# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role bypasses RLS. Server + worker only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Credential custody
# ---------------------------------------------------------------------------
# Comma-separated `keyId:base64key` entries. First entry is ACTIVE (used for new
# writes); the rest are kept only so previously-wrapped DEKs stay readable.
# Generate one with:  openssl rand -base64 32
STACK_SENTRY_MASTER_KEY=k1:REPLACE_WITH_BASE64_32_BYTES

# ---------------------------------------------------------------------------
# LLM routing — local-first, not local-only
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Frontier fallback. Only used when Ollama would degrade UX or is unreachable
# (e.g. anything running inside a Supabase Edge Function).
ANTHROPIC_API_KEY=
# Set to 1 to force the frontier path (useful for testing the fallback).
STACK_SENTRY_DISABLE_OLLAMA=

# ---------------------------------------------------------------------------
# Stripe (direct, not Connect — we take the payment)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# ---------------------------------------------------------------------------
# Zapier OAuth (first connector)
# ---------------------------------------------------------------------------
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=
ZAPIER_REDIRECT_URI=http://localhost:3000/api/oauth/zapier/callback

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@stacksentry.app
# SMS is wired but stays dark until there is revenue to justify the spend.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OAuth state signing (contracts 2 and 3)
# ---------------------------------------------------------------------------
# HMAC key for the OAuth `state` parameter. Without it, the connect flow is
# CSRF-open. Generate with: openssl rand -base64 32
STACK_SENTRY_OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# Instrumentation (free tier — no spend)
# ---------------------------------------------------------------------------
# Absent = analytics is a no-op. Capture is fail-open and never blocks a request.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=

# Analytics sink is the Supabase `analytics_events` table — no vendor key needed.
# Capture is a no-op without SUPABASE_SERVICE_ROLE_KEY, never an error.
